    Knob.Position = UDim2.new(0, 2, 0.5, -8.5)
    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Knob.Parent = Track
    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

    local Click = Instance.new("TextButton")
    Click.Size = UDim2.new(1, 0, 1, 0)
    Click.BackgroundTransparency = 1
    Click.Text = ""
    Click.Parent = Btn

    local On = false
    Click.MouseButton1Click:Connect(function()
        On = not On
        Tween:Create(Track, TweenInfo.new(0.15), {BackgroundColor3 = On and Color3.fromRGB(0, 180, 50) or Color3.fromRGB(70, 70, 70)}):Play()
        Tween:Create(Knob, TweenInfo.new(0.15), {Position = On and UDim2.new(1, -19, 0.5, -8.5) or UDim2.new(0, 2, 0.5, -8.5)}):Play()
        task.spawn(function() callback(On) end)
    end)
end

